":"2026-06-22T09:29:47.52869Z"}},"outputs":[],"execution_count":9},{"id":"cd9f2ba9","cell_type":"code","source":"def recommend_complementary(product_idx, top_k=5, prefer_same_gender=True, prefer_same_season=True):\n    query_row = df.iloc[product_idx]\n    query_emb = image_embeddings[product_idx].reshape(1, -1)\n\n    target_subcats = get_complementary_subcategories(query_row[\"subCategory\"])\n    candidates = df[\n        (df[\"subCategory\"].isin(target_subcats)) & (df.index != product_idx)\n    ].copy()\n\n    if candidates.empty:\n        return df.iloc[[]], []\n\n    cand_idx = candidates.index.to_numpy()\n    cand_embs = image_embeddings[cand_idx]\n    sims = cosine_similarity(query_emb, cand_embs)[0]\n\n    # Soft boosts for matching gender / season so recommendations make practical sense.\n    boost = np.zeros_like(sims)\n    if prefer_same_gender and \"gender\" in candidates.columns:\n        boost += 0.05 * (candidates[\"gender\"].values == query_row[\"gender\"])\n    if prefer_same_season and \"season\" in candidates.columns:\n        boost += 0.03 * (candidates[\"season\"].values == query_row[\"season\"])\n\n    score = sims + boost\n    candidates = candidates.assign(score=score, raw_sim=sims)\n\n    # Diversify across complementary subcategories instead of returning 5 of the same subcategory.\n    candidates = candidates.sort_values(\"score\", ascending=False)\n    picked, seen_subcats = [], set()\n    for _, row in candidates.iterrows():\n        if row[\"subCategory\"] not in seen_subcats or len(picked) < top_k:\n            picked.append(row)\n            seen_subcats.add(row[\"subCategory\"])\n        if len(picked) >= top_k:\n            break\n    result = pd.DataFrame(picked).head(top_k)\n    return result, result[\"raw_sim\"].tolist()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T09:29:47.530269Z","iopub.execute_input":"2026-06-22T09:29:47.530607Z","iopub.status.idle":"2026-06-22T09:29:47.543663Z","shell.execute_r